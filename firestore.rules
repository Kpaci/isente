rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Common security helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (request.auth.token.email == 'pacifique.k01@gmail.com');
    }

    // User profile and subcollections
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['uid', 'currency'])
        && request.resource.data.uid == userId;
      allow update: if isOwner(userId)
        && request.resource.data.uid == userId;
      allow delete: if isOwner(userId);

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(transactionId)
          && request.resource.data.userId == userId
          && request.resource.data.keys().hasAll(['id', 'userId', 'type', 'amount', 'category', 'date'])
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0;
        allow update: if isOwner(userId)
          && isValidId(transactionId)
          && request.resource.data.userId == userId
          && request.resource.data.amount is number;
        allow delete: if isOwner(userId);
      }

      // Categories subcollection
      match /categories/{categoryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(categoryId)
          && request.resource.data.userId == userId
          && request.resource.data.keys().hasAll(['id', 'userId', 'label', 'icon', 'color']);
        allow update: if isOwner(userId)
          && isValidId(categoryId)
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }

      // Budgets subcollection
      match /budgets/{budgetId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(budgetId)
          && request.resource.data.userId == userId
          && request.resource.data.overallLimit is number
          && request.resource.data.overallLimit >= 0;
        allow update: if isOwner(userId)
          && isValidId(budgetId)
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }

      // Debts / IOUs subcollection
      match /debts/{debtId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(debtId)
          && request.resource.data.userId == userId
          && request.resource.data.keys().hasAll(['id', 'userId', 'type', 'counterpartyName', 'initialAmount', 'remainingAmount', 'status'])
          && request.resource.data.initialAmount is number
          && request.resource.data.remainingAmount is number;
        allow update: if isOwner(userId)
          && isValidId(debtId)
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }

      // Savings Goals subcollection
      match /savingsGoals/{goalId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(goalId)
          && request.resource.data.userId == userId
          && request.resource.data.keys().hasAll(['id', 'userId', 'title', 'targetAmount', 'currentAmount', 'vehicleName'])
          && request.resource.data.targetAmount is number
          && request.resource.data.currentAmount is number;
        allow update: if isOwner(userId)
          && isValidId(goalId)
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }

      // Recurring Expenses subcollection
      match /recurringExpenses/{recurringId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(recurringId)
          && request.resource.data.userId == userId
          && request.resource.data.keys().hasAll(['id', 'userId', 'title', 'amount', 'category', 'frequency'])
          && request.resource.data.amount is number;
        allow update: if isOwner(userId)
          && isValidId(recurringId)
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }
    }

    // App Configuration (e.g. Native Android APK release URL & version)
    match /app_config/{configId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
        && isValidId(configId)
        && request.resource.data.keys().hasAll(['downloadUrl', 'version'])
        && request.resource.data.downloadUrl is string
        && request.resource.data.downloadUrl.size() > 0
        && request.resource.data.downloadUrl.size() <= 2048
        && request.resource.data.version is string
        && request.resource.data.version.size() <= 50;
      allow delete: if isAdmin();
    }
  }
}
